#!/bin/bash

APP="$HOME/Applications/HP 117w Manual Duplex.app"
SPOOL="${3:-}"

if [ -z "$SPOOL" ] || [ ! -f "$SPOOL" ]; then
	exit 0
fi

# Bypass the applet: it may already be waiting for the current print session.
PYTHON=$(/usr/bin/plutil -extract ProgramArguments.0 raw -o - "$HOME/Library/LaunchAgents/local.hp117w.mobile.plist")
"$PYTHON" "$APP/Contents/Resources/mobile.py" enqueue "$SPOOL"
exit 0
